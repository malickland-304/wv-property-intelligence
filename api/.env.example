# ── Server ─────────────────────────────────────────────────────────────────────
PORT=3001
NODE_ENV=development

# ── Database ────────────────────────────────────────────────────────────────────
# Default: ./database/wv_property.db (relative to project root)
# Railway: create a Volume → mount at /data → set DATABASE_PATH=/data/wv_property.db
DATABASE_PATH=./database/wv_property.db

# ── Admin panel ─────────────────────────────────────────────────────────────────
ADMIN_PASSWORD=change-me-in-production
SESSION_SECRET=change-me-in-production

# Optional comma-separated CORS allowlist for cross-origin calls.
# Same-origin requests are allowed automatically.
CORS_ORIGIN=

# ── REST API auth ───────────────────────────────────────────────────────────────
# Required to use POST/PUT/DELETE /api/properties and GET /api/contacts.
# Leave blank in development to allow unauthenticated API access.
API_KEY=your-secret-api-key

# ── Gmail notifications (optional) ─────────────────────────────────────────────
# Sends an email to NOTIFICATION_EMAIL every time a lead inquiry is submitted.
# Setup: https://console.cloud.google.com → enable Gmail API → OAuth2 Client ID
#   Use OAuth Playground to get a refresh token with scope:
#   https://www.googleapis.com/auth/gmail.send
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_GMAIL_USER=malickland@gmail.com
NOTIFICATION_EMAIL=phil@malickland.net

# ── Google Drive photo backup (optional) ────────────────────────────────────────
# Uploads compressed photos to Drive after each upload.
# Enable Google Drive API in the same Cloud project, add scope:
#   https://www.googleapis.com/auth/drive.file
# Get the folder ID from the Drive URL: drive.google.com/drive/folders/{ID}
GOOGLE_DRIVE_FOLDER_ID=

# ── AI content + public assistant (optional) ────────────────────────────────────
# Powers /admin/ai/:id (listing marketing packages) AND the public POST /api/chat
# assistant widget on the homepage. Cost: ~$0.01–0.03 per listing generation;
# chat replies are short (capped output) and the endpoint is per-IP rate limited.
# When unset, both features degrade gracefully (admin is a no-op; chat returns a
# brokerage-safe "call Phil" fallback) — the site never crashes for a missing key.
#
# Provider precedence: AI_GATEWAY_API_KEY → ANTHROPIC_API_KEY → OPENAI_API_KEY.
# The first one set wins; set exactly one.
#
# Option 1 — Vercel AI Gateway: model failover, spend tracking, observability,
# one place to cap cost. NOTE: Vercel's free gateway credits do NOT cover Claude
# (premium models 403 until you add paid credits). Get a key from the Vercel
# dashboard → AI Gateway.
AI_GATEWAY_API_KEY=
# Optional model overrides. Browse slugs: https://ai-gateway.vercel.sh/v1/models
# Defaults: AI_GATEWAY_MODEL=openai/gpt-5.4  AI_GATEWAY_FALLBACK_MODEL=anthropic/claude-haiku-4.5
AI_GATEWAY_MODEL=
AI_GATEWAY_FALLBACK_MODEL=
#
# Option 2 — Direct Anthropic (Claude without the gateway; cheapest path to
# Claude). Used only when AI_GATEWAY_API_KEY is empty. Get key:
# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
# Optional model overrides (defaults: haiku primary, sonnet auto-fallback).
# For richer admin listing copy, set ANTHROPIC_MODEL=claude-sonnet-4-6.
# Defaults: ANTHROPIC_MODEL=claude-haiku-4-5  ANTHROPIC_FALLBACK_MODEL=claude-sonnet-4-6
ANTHROPIC_MODEL=
ANTHROPIC_FALLBACK_MODEL=
#
# Option 3 — Direct OpenAI — used only when the two above are empty.
# Get key: https://platform.openai.com/api-keys
OPENAI_API_KEY=
# Optional model override (defaults to gpt-4o, auto-falls back to gpt-4o-mini on access errors)
OPENAI_MODEL=
