# ── Server ───────────────────────────────────────────────────
PORT=3000
NODE_ENV=production
DATABASE_PATH=/data/wv_property.db
ADMIN_PASSWORD=wvrea2026
SESSION_SECRET=change-me-in-production
API_KEY=change-me-api-key

# ── Google OAuth2 (Gmail + Drive) ────────────────────────────
# Create credentials at https://console.cloud.google.com/
# 1. Enable Gmail API and Google Drive API
# 2. Create an OAuth 2.0 Client ID (Desktop or Web application)
# 3. Use the OAuth Playground (https://developers.google.com/oauthplayground)
#    to generate a refresh token with these scopes:
#      https://www.googleapis.com/auth/gmail.send
#      https://www.googleapis.com/auth/drive.file
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=

# The Gmail address that will send notification emails (must match the OAuth account)
GOOGLE_GMAIL_USER=

# Email address that will RECEIVE inquiry notifications
NOTIFICATION_EMAIL=
LEADS_NOTIFICATION_EMAIL=phil@malickland.net

# Google Drive folder ID where property photo folders will be created
# (Right-click a Drive folder → Get link → copy the ID from the URL)
GOOGLE_DRIVE_FOLDER_ID=

# Google Sheets lead capture
GOOGLE_SHEETS_SPREADSHEET_ID=
GOOGLE_SHEETS_LEADS_TAB=37_Advent_Leads
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_KEY_HERE\n-----END PRIVATE KEY-----\n"

# Twilio lead alerts
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
LEAD_ALERT_TO_NUMBER=+15402461421
SITE_URL=https://malickland.net
