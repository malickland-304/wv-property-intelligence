# ── Server ────────────────────────────────────────────────
PORT=3000
# CRITICAL on Railway/Render: point this to a mounted persistent volume path
# Railway: create a Volume → mount at /data → set DATABASE_PATH=/data/wv_property.db
# Render: add a Persistent Disk → mount at /data → set DATABASE_PATH=/data/wv_property.db
# Without this, redeploys WILL wipe your leads database
DATABASE_PATH=/data/wv_property.db
SESSION_SECRET=change-me-session-secret
ADMIN_PASSWORD=change-me-admin-password

# ── Google OAuth2 (Gmail + Drive integration) ─────────────
# 1. Create a project at https://console.cloud.google.com/
# 2. Enable Gmail API and Google Drive API
# 3. Create an OAuth 2.0 Client ID (Desktop application type)
# 4. Get a refresh token via https://developers.google.com/oauthplayground
#    Scopes needed:
#      https://www.googleapis.com/auth/gmail.send
#      https://www.googleapis.com/auth/drive.file
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=

# ── Gmail notifications ───────────────────────────────────
# The Gmail address to send FROM (must match the OAuth account)
GOOGLE_GMAIL_USER=malickland@gmail.com
# Where inquiry emails are delivered
NOTIFICATION_EMAIL=malickland@gmail.com

# ── Google Drive photo backup ─────────────────────────────
# Folder ID from the Drive URL:
# https://drive.google.com/drive/folders/FOLDER_ID_HERE
GOOGLE_DRIVE_FOLDER_ID=

# ── OpenAI (listing description generation) ──────────────
OPENAI_API_KEY=

# ── Anthropic / Claude (chatbot widget) ───────────────────
ANTHROPIC_API_KEY=

# ── Slack (lead notifications → #all-malickland) ─────────
# Create at: https://api.slack.com/apps → Incoming Webhooks
SLACK_WEBHOOK_URL=

# ── Site ──────────────────────────────────────────────────
SITE_URL=https://malickland.net
